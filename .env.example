# Copy to .env and adjust. Only APP_SECRET and PUBLIC_URL matter for a basic setup.

# 32+ random characters. Encrypts stored mail passwords and OAuth tokens.
# Generate one with:  openssl rand -base64 48
# Keep it safe and keep it out of the data volume: without it, saved credentials are unreadable.
APP_SECRET=

# The URL people use to reach HomeMail (no trailing slash). Used for OAuth redirects
# and to decide whether session cookies are marked Secure (https = yes).
PUBLIC_URL=http://localhost:3000

# Allow anyone who can reach the server to create a user (the first user is always allowed
# and becomes admin). Admins can also toggle this in the UI.
ALLOW_REGISTRATION=false

# Which reverse proxies to trust for X-Forwarded-* headers (Express "trust proxy" syntax).
# Default trusts loopback and private networks, which suits most homelab reverse proxies.
# TRUST_PROXY=loopback,uniquelocal

# --- Sign in with Google (Gmail). Optional: Gmail also works with app passwords. ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Sign in with Microsoft. Required for Outlook.com / Hotmail / Live accounts. ---
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# "common" = personal + work accounts, "consumers" = personal only, or your tenant ID.
# MICROSOFT_TENANT=common

# Check POP3 accounts for new mail every N minutes (0 = only when you open the inbox).
# POP3_POLL_MINUTES=10

# Max total attachment size per message, in MB.
# MAX_UPLOAD_MB=25

# Look up unknown domains in Mozilla's ISPDB (autoconfig.thunderbird.net) when adding accounts.
# AUTODETECT_ONLINE=true

# Session lifetime in days.
# SESSION_DAYS=30
