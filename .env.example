# Copy to .env and adjust. For Docker Compose, set APP_SECRET, STALWART_ADMIN_PASSWORD,
# XMPP_COMPONENT_SECRET and PUBLIC_URL; everything else has sensible defaults.

# 32+ random characters. Encrypts stored mail passwords and OAuth tokens.
# Generate one with:  openssl rand -base64 48
# Keep it safe and keep it out of the data volume: without it, saved credentials are unreadable.
APP_SECRET=

# The URL people use to reach HomeMail (no trailing slash). Used for OAuth redirects
# and to decide whether session cookies are marked Secure (https = yes).
PUBLIC_URL=http://localhost:3000

# --- Your server's own addresses -------------------------------------------------------
# Users get username@<domain>. Defaults: chat home.mail; mail home.mail (built-in server)
# or home.internal (Stalwart, which only accepts domains under a real top-level domain).
# Mail to and from the internet, and chat federation, need a domain you own with DNS records
# (the admin "Server" page lists them). Admins can change these in the UI too.
# SERVER_DOMAIN=example.com
# CHAT_DOMAIN=example.com
# MAIL_DOMAIN=example.com
# MAIL_HOSTNAME=mail.example.com

# Mail server: builtin | stalwart | external | off. Docker Compose defaults to stalwart;
# running from source defaults to builtin. Admins can switch in Settings -> Server.
# MAIL_SERVER_MODE=stalwart

# Docker Compose: password HomeMail uses to manage Stalwart (also its admin page login).
# Generate with:  openssl rand -base64 24
STALWART_ADMIN_PASSWORD=

# Docker Compose: shared secret between HomeMail and Prosody for chat federation.
XMPP_COMPONENT_SECRET=
# Let people on other XMPP servers chat with your users (Docker default: true).
# CHAT_FEDERATION=true

# Built-in mail server (when MAIL_SERVER_MODE=builtin): port for incoming SMTP.
# Forward port 25 from the internet to it. Optional TLS certificate for STARTTLS.
# BUILTIN_SMTP_PORT=2525
# BUILTIN_SMTP_TLS_CERT=/path/fullchain.pem
# BUILTIN_SMTP_TLS_KEY=/path/privkey.pem

# Allow anyone who can reach the server to create a user (the first user is always allowed
# and becomes admin). Admins can also toggle this in the UI.
ALLOW_REGISTRATION=false

# Which reverse proxies to trust for X-Forwarded-* headers (Express "trust proxy" syntax).
# Default trusts loopback and private networks, which suits most homelab reverse proxies.
# TRUST_PROXY=loopback,uniquelocal

# --- Sign in with Google (Gmail). Optional: Gmail also works with app passwords. ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Sign in with Microsoft. Required for Outlook.com / Hotmail / Live accounts. ---
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# "common" = personal + work accounts, "consumers" = personal only, or your tenant ID.
# MICROSOFT_TENANT=common

# Check POP3 accounts for new mail every N minutes (0 = only when you open the inbox).
# POP3_POLL_MINUTES=10

# Sync calendar accounts (Google, Microsoft, CalDAV, .ics feeds) every N minutes (0 = only on demand).
# CALENDAR_SYNC_MINUTES=15

# Max total attachment size per message, in MB.
# MAX_UPLOAD_MB=25

# Look up unknown domains in Mozilla's ISPDB (autoconfig.thunderbird.net) when adding accounts.
# AUTODETECT_ONLINE=true

# Session lifetime in days.
# SESSION_DAYS=30
